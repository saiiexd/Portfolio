# =============================================================================
# ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values before running.
# None of these are exposed as secrets — NEXT_PUBLIC_ prefix means they are
# safe to include in client-side bundles. They are NOT secret API keys.
# =============================================================================

# Formspree form ID — sign up at https://formspree.io and paste your form ID here.
# Example: xpzywrkq
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id_here
